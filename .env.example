# ==========================================================
# AI Cost Optimization Platform - Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==========================================================

# --- Required: AI Engine ---
# Get a key at https://console.anthropic.com/
# NEVER commit a real key — add it only in your local .env
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Server ---
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Dashboard (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
# Ports must match docker-compose.yml mappings
DB_HOST=localhost
DB_PORT=5433
DB_NAME=cost_optimization
DB_USER=postgres
DB_PASSWORD=password

# --- Cache (Redis) ---
REDIS_URL=redis://127.0.0.1:6380

# --- Optional: skip DB/Redis entirely and run on in-memory fallbacks ---
# Set these to true if you intentionally want a no-Docker local demo.
SKIP_DATABASE=true
SKIP_REDIS=true

# --- Optional: Azure Cost Management (only needed for real billing data) ---
# Create with:
#   az login
#   az ad sp create-for-rbac --name "cost-optimization-app" \
#     --role "Cost Management Reader" \
#     --scopes "/subscriptions/YOUR_SUBSCRIPTION_ID"
# Leave blank to run entirely on the built-in simulated enterprise dataset.
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
